# Public DNS name that points to this VPS. Caddy obtains and renews TLS.
CLOUDPOS_DOMAIN=pos.example.com

# Keep this password long, unique and URL-safe (letters, digits, - and _).
POSTGRES_DB=cloudpos
POSTGRES_USER=cloudpos_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Empty is correct when the dashboard and API share this domain.
CLOUDPOS_WEB_CORS_ORIGINS=
CLOUDPOS_WEB_SESSION_HOURS=8

# VPS-only secret used to provision/revoke desktop device tokens. Never copy it
# to a customer PC or browser.
CLOUDPOS_ADMIN_API_KEY=replace-with-a-separate-long-random-secret
