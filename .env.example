# =============================================================
#  CloudPOS — environment configuration template
#  Copy this file to .env and fill in your values.
#  cp .env.example .env
# =============================================================

# -------------------------------------------------------------
#  LOCAL DATABASE
# -------------------------------------------------------------
# SQLite path (relative to the executable / project root).
DATABASE_URL=sqlite:///pos_system.db

# -------------------------------------------------------------
#  SUPABASE — cloud sync (leave blank to run offline only)
# -------------------------------------------------------------

# Direct PostgreSQL connection string (for background sync worker).
# Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_CLOUD_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase project URL (REST API base).
# Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Service role secret key (server-side only, never expose to clients).
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Background sync interval in seconds (default 300 = 5 minutes).
CLOUD_SYNC_INTERVAL=300
