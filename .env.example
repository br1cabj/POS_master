# ─────────────────────────────────────────────────────────────────
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo .env a control de versiones.
# ─────────────────────────────────────────────────────────────────

# URL de la base de datos
# SQLite (desarrollo):
DATABASE_URL=sqlite:///pos_system.db
# PostgreSQL (producción):
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/pos_db

# Salt secreto para la generación y verificación de licencias.
# Debe ser una cadena larga y aleatoria. Cámbiala antes de producción.
SECRET_SALT=cambia_esto_por_un_valor_secreto_largo
