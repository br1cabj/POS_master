# =============================================================
#  CloudPOS — environment configuration template
#  Copy this file to .env and fill in your values.
#  cp .env.example .env
# =============================================================

# -------------------------------------------------------------
#  LOCAL DATABASE
# -------------------------------------------------------------
# SQLite path (relative to the executable / project root).
DATABASE_URL=sqlite:///pos_system.db

# -------------------------------------------------------------
#  CLOUD ADD-ON — optional mobile reports (leave blank to run offline only)
# -------------------------------------------------------------

# URL of your CloudPOS VPS.  The desktop sends encrypted HTTPS requests; it
# never connects to PostgreSQL directly.
CLOUDPOS_SYNC_API_URL=https://pos.example.com/api/v1

# Per-device credential issued by the VPS pairing flow. Do not share it.
CLOUDPOS_DEVICE_TOKEN=

# Background sync interval in seconds (default 300 = 5 minutes).
CLOUD_SYNC_INTERVAL=300
